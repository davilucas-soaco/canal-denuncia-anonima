# API
PORT=3001
# Origens permitidas (público + admin), separadas por vírgula
# Origens extras (além de localhost em qualquer porta no dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_ALLOW_LOCALHOST=true

# JWT do painel interno
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

# Senha inicial dos usuários seed (RH e Diretoria)
ADMIN_SEED_PASSWORD=admin123

# SQL Server Express local (sem Docker)
# Arquivos do banco: data/CanalDenuncia.mdf e data/CanalDenuncia_log.ldf
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=CanalDenuncia
MSSQL_TRUSTED_CONNECTION=true

DATA_DIR=../data
UPLOAD_DIR=../data/uploads

# E-mail (Gmail API OAuth) — credenciais ficam no banco; aqui só a chave de criptografia
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SETTINGS_ENCRYPTION_KEY=

# true = envio real; omita ou false em desenvolvimento (dry-run)
NOTIFICACOES_ENVIO_HABILITADO=false

# URL do painel admin (link "Abrir no painel" nos e-mails de nova denúncia)
ADMIN_BASE_URL=http://localhost:5174

# URL do site público (link "Consultar protocolo" no e-mail de pedido de complemento)
PUBLIC_BASE_URL=http://localhost:5173
